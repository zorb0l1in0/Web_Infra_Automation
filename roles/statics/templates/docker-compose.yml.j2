services:
{% for i in range(1, nginx_replicas + 1) %}
  nginx-{{ i }}:
    image: nginx:latest
    container_name: nginx-{{ i }}
    restart: unless-stopped
    volumes:
      - ./conf/nginx-{{ i }}.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - {{ docker_network }}
{% endfor %}

networks:
  {{ docker_network }}:
    external: true